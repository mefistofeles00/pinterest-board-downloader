{
  "manifest_version": 3,
  "name": "Pinterest Board Downloader",
  "version": "1.0.0",
  "description": "Bir Pinterest board'undaki tüm pinleri listeler ve görsellerini board adına göre bir klasöre toplu indirir.",
  "permissions": ["downloads", "downloads.shelf", "activeTab", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://i.pinimg.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pinterest Board Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
